{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**/*.ts", "**/*.tsx", "**/*.json", "**/*.css", "!**/node_modules", "!**/.next", "!**/out"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "css": { "parser": { "cssModules": false } },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  }
}
